# Recommended NVIDIA NIM configuration for fast policy translation.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_API_KEY=

# Override only if Binance publishes a replacement endpoint.
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# Production-only Binance Agent OS OAuth secrets. Set these in Cloudflare;
# never place their real values in source control.
BINANCE_OAUTH_ENCRYPTION_KEY=
BINANCE_CONNECT_ADMIN_TOKEN=
