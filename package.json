{
  "name": "riskgate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node --dns-result-order=ipv4first --no-network-family-autoselection ./node_modules/wrangler/bin/wrangler.js deploy --config wrangler.jsonc",
    "cf:build": "opennextjs-cloudflare build",
    "cf:whoami": "wrangler whoami",
    "cf:d1:create": "wrangler d1 create riskgate-db --location weur",
    "db:migrate:local": "wrangler d1 migrations apply riskgate-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply riskgate-db --remote",
    "cf:tail": "wrangler tail riskgate",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0"
  }
}
